cc_library_shared {
    name: "hwcomposer_celadon.filegroups_build_test",
    defaults: ["hwcomposer.drm_celadon_defaults"],

    srcs: [
        ":drm_hwcomposer_celadon_common",
        ":drm_hwcomposer_celadon_platformhisi",
        ":drm_hwcomposer_celadon_platformimagination",
        ":drm_hwcomposer_celadon_platformmediatek",
        ":drm_hwcomposer_celadon_platformmeson",
    ],

    shared_libs: [
        "android.hardware.graphics.composer3-V4-ndk",
        "libbinder_ndk",
        "libhwcservice_celadon",
    ],

    local_include_dirs: [
        "test_include",
    ],

    cppflags: [
        "-DDISABLE_LEGACY_GETTERS",
    ],
}

// Tool for listening and dumping uevents
cc_test {
    name: "hwc_celadon-drm-uevent-print",

    srcs: [
        ":drm_hwcomposer_celadon_fd",
        "uevent_print.cpp",
    ],

    vendor: true,
    header_libs: [
        "drm_hwcomposer_celadon_headers",
        "libhardware_headers",
    ],
    shared_libs: ["liblog"],
}
